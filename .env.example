# ===== 数据库（云服务模式：生产替换为云托管 PostgreSQL 连接串）=====
DATABASE_URL=postgres://wt:wt_dev_password@localhost:5432/werewolf

# ===== 裁判 LLM（多供应商，二选一）=====
# anthropic | openai（openai 兼容任意端点：DeepSeek/Qwen/GLM/vLLM 等）
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-your-key
LLM_MODEL=claude-sonnet-5
# 仅 openai 兼容端点需要；anthropic 官方可留空
LLM_BASE_URL=
# 公告用便宜模型（留空则复用 LLM_MODEL）
LLM_MODEL_ANNOUNCE=

# ===== 服务 =====
PORT=3000
HOST=0.0.0.0
# 观战 god 全知视角的管理员 token
WT_ADMIN_TOKEN=change-me

# ===== Agent 沙箱：none(本地开发) | docker(正式赛, Linux) =====
WT_SANDBOX=none
# 选手 agent 可用的决策 LLM（平台代理，沙箱内仅可访问此代理）
WT_AGENT_LLM_MODEL=
WT_AGENT_LLM_DAILY_TOKEN_BUDGET=2000000
