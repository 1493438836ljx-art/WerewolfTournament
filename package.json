{
  "name": "werewolf-tournament",
  "private": true,
  "version": "0.1.0",
  "description": "AI Coding 比赛平台 —— 狼人杀 Sub Agent 锦标赛",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "dev:server": "pnpm --filter @wt/server dev",
    "dev:web": "pnpm --filter @wt/web dev",
    "db:migrate": "pnpm --filter @wt/server db:migrate",
    "db:generate": "pnpm --filter @wt/server db:generate",
    "sim": "tsx scripts/sim.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
